{
  "name": "@runway/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sandbox-demo": "tsx sandbox-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "sandbox-demo:inr": "tsx sandbox-demo.ts --inr",
    "submit-payload": "tsx submit-payload.ts",
    "print-init": "tsx print-init.ts",
