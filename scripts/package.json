    "@runway/inr-gateway": "workspace:*",
    "@runway/scoring": "workspace:*",
    "@runway/sdk": "workspace:*",
    "@runway/underwriter": "workspace:*",
    "hono": "4.13.14",
    "near-api-js": "5.1.1",
    "near-workspaces": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
