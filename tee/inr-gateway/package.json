{
  "name": "@runway/inr-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock-routes.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "build:mainnet": "esbuild src/main.ts --bundle --platform=node --format=esm --minify-syntax --packages=external --define:process.env.NETWORK='\"mainnet\"' --outfile=dist/main.mainnet.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@runway/agent-kit": "workspace:*",
    "@runway/config": "workspace:*",
    "@runway/fx": "workspace:*",
    "@runway/sdk": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
