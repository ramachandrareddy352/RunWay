# Public settings for the web app (Next.js reads apps/web/.env.local; on Vercel set them in the
# project's Environment Variables). Values here are the testnet defaults.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RUNWAY_ROOT=runway-rama.testnet
# services/node exposes all three under one URL: <node>/api, <node>/uw, <node>/gw
NEXT_PUBLIC_API_URL=http://localhost:8787/api
NEXT_PUBLIC_UNDERWRITER_URL=http://localhost:8787/uw
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787/gw
# Optional: comma-separated RPCs (two independent providers; reads must agree)
NEXT_PUBLIC_RPC_URLS=
