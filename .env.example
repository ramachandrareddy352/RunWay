# Names only — never commit values. Copy to .env (git-ignored) and fill in.
# Nothing here is needed for `make test` or `make sandbox-demo`.
# Where each group goes when hosted: see docs/DEPLOY.md (Render for services/node, Vercel for apps/web).

# --- services/node: shared ---
NETWORK=testnet
NEAR_NETWORK=testnet
RUNWAY_ROOT=runway-rama.testnet
PORT=
# Optional RPC override for the API's signer (default: the testnet profile's first RPC)
NEAR_RPC_URL=

# --- services/node: API + keeper ---
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
DATABASE_PATH=
ONECLICK_API_KEY=

# --- services/node: agents (Shade local mode; keys come from .env.agents.local after deploy-testnet) ---
UNDERWRITER_AGENT_ACCOUNT_ID=
UNDERWRITER_AGENT_PRIVATE_KEY=
GATEWAY_AGENT_ACCOUNT_ID=
GATEWAY_AGENT_PRIVATE_KEY=
# Seed for the local-mode app key (anchor HMACs, beneficiary blobs); keep it stable and secret
AGENT_DERIVATION_PATH=
NEARAI_API_KEY=
NEARAI_DAILY_CALLS=
# INR gateway
INR_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
# Public https URL of services/node (the SIMULATED UPI page links are built from it; Render: automatic)
PUBLIC_URL=
GATEWAY_DATABASE_PATH=
# Only when the gateway runs on its own (services/node sets it to itself)
API_URL=
# TEE mode (Phala): TEE=1 and no *_AGENT_PRIVATE_KEY; the agents then boot ShadeClient
TEE=
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# Live Razorpay (not used while INR_PROVIDER=mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# --- scripts ---
PINATA_JWT=

# --- apps/web (Vercel project env, or apps/web/.env.local; see apps/web/.env.example) ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RUNWAY_ROOT=runway-rama.testnet
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_UNDERWRITER_URL=
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_RPC_URLS=
